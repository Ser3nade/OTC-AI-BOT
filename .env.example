BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
PRICE_SHEET_ID=YOUR_PRICE_SHEET_ID
PRICE_WORKSHEET_NAME=Prices
TRADER_GROUP_CHAT_ID=-1001234567890

# Optional: comma-separated Telegram user IDs for traders.
# Traders can type /whoami to get their user ID.
TRADER_USER_IDS=123456789,987654321

# Optional but recommended for Sprint 3 trade logging.
TRADE_LOG_SHEET_ID=YOUR_TRADE_LOG_SHEET_ID

# Default creates/uses monthly tabs like 2026-07 using PH time.
TRADE_LOG_WORKSHEET_TEMPLATE=%Y-%m

# Use this only if you want one fixed tab instead of monthly tabs.
TRADE_LOG_WORKSHEET_NAME=
